{
  "name": "dsh-wordhelper",
  "version": "0.1.0",
  "description": "划词助手：选中文字即弹出翻译 / 解释 / 复制 / 搜索 / 收藏浮条，左侧栏另有划词本面板与设置。 · Word Helper: a selection toolbar with translate/explain/copy/search/save plus a sidebar notebook panel.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "selection",
    "translate",
    "word-helper"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "license": "MIT"
}
